# Google ID Token의 audience를 검증하는 공개 Web Client ID다.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Kakao 개발자 콘솔의 숫자 App ID다.
KAKAO_APP_ID=your-numeric-kakao-app-id
# Naver 프로필 API 호출용 서버 자격 증명이다. Secret은 Android 앱에 넣지 않는다.
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# Step Tune JWT 서명용 최소 32문자 랜덤 비밀값이다.
JWT_SECRET=replace-with-at-least-32-random-characters

# Compose MySQL의 기본 접속 정보다. 로컬 기본값과 같으면 생략할 수도 있다.
DB_URL=jdbc:mysql://localhost:3306/step_tune?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=step_tune
DB_PASSWORD=step_tune_local_password
